# FlightCore Telemetry & Ground Station Configuration Template
# Copy to .env for local ground station CLI overrides (never commit real .env)

# Ground Station Serial Port (Windows: COM3, Linux: /dev/ttyUSB0, macOS: /dev/cu.usbserial-0001)
FLIGHTCORE_SERIAL_PORT=COM3
FLIGHTCORE_SERIAL_BAUD=115200

# LoRa RF Profile (must match firmware config.h)
FLIGHTCORE_LORA_FREQ_MHZ=433.0
FLIGHTCORE_LORA_SF=7
FLIGHTCORE_LORA_BW_KHZ=125.0
FLIGHTCORE_LORA_CR=5
FLIGHTCORE_LORA_SYNC_WORD=0x12

# Telemetry Logging Output
FLIGHTCORE_LOG_DIR=./logs
FLIGHTCORE_LOG_FORMAT=jsonl

# Safety Notice: FlightCore is strictly telemetry-only. No flight control parameters exist.
